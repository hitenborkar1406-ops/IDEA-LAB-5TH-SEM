# Smart Traffic Management Platform Configuration

# FastAPI Backend Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000

# Simulation Engine Mode: 'auto' (detects SUMO if installed, else falls back to queueing), 'queueing', or 'sumo'
SIMULATION_ENGINE_TYPE=sumo

# SUMO Path (Used when SUMO binary is installed)
SUMO_HOME=C:/Program Files (x86)/Eclipse/Sumo
